;; extends

; Draw ASCII TLA+ operators as their Unicode symbols without changing the file.
; Covers every symbol in the TLA+ Unicode standard (RFC 5), same table as tlaplus-nvim-plugin.
; Shown when conceallevel > 0 (set for tla buffers in lua/plugins/lsp-utils.lua).

; Definitions, quantifiers and structure
((def_eq) @operator (#set! conceal "≜"))
([(in) (set_in)] @operator (#set! conceal "∈"))
((notin) @operator (#set! conceal "∉"))
((gets) @operator (#set! conceal "←"))
((forall) @keyword (#set! conceal "∀"))
((exists) @keyword (#set! conceal "∃"))
((all_map_to) @operator (#set! conceal "↦"))
([(maps_to) (case_arrow)] @operator (#set! conceal "→"))
((langle_bracket) @punctuation.bracket (#set! conceal "⟨"))
((rangle_bracket) @punctuation.bracket (#set! conceal "⟩"))
; >>_ keeps its underscore: only the >> part is drawn as ⟩
((rangle_bracket_sub) @punctuation.bracket
  (#offset! @punctuation.bracket 0 0 0 -1)
  (#set! conceal "⟩"))
((case_box) @operator (#set! conceal "□"))
((label_as) @operator (#set! conceal "∷"))

; Logic and temporal
([(land) (bullet_conj)] @operator (#set! conceal "∧"))
([(lor) (bullet_disj)] @operator (#set! conceal "∨"))
((lnot) @operator (#set! conceal "¬"))
((implies) @operator (#set! conceal "⇒"))
((iff) @operator (#set! conceal "⇔"))
((equiv) @operator (#set! conceal "≡"))
((always) @operator (#set! conceal "□"))
((eventually) @operator (#set! conceal "◇"))
((leads_to) @operator (#set! conceal "↝"))
((plus_arrow) @operator (#set! conceal "⇸"))

; Relations
((neq) @operator (#set! conceal "≠"))
((leq) @operator (#set! conceal "≤"))
((geq) @operator (#set! conceal "≥"))
((approx) @operator (#set! conceal "≈"))
((asymp) @operator (#set! conceal "≍"))
((cong) @operator (#set! conceal "≅"))
((doteq) @operator (#set! conceal "≐"))
((gg) @operator (#set! conceal "≫"))
((ll) @operator (#set! conceal "≪"))
((prec) @operator (#set! conceal "≺"))
((succ) @operator (#set! conceal "≻"))
((preceq) @operator (#set! conceal "⪯"))
((succeq) @operator (#set! conceal "⪰"))
((propto) @operator (#set! conceal "∝"))
((sim) @operator (#set! conceal "∼"))
((simeq) @operator (#set! conceal "≃"))
((rs_ttile) @operator (#set! conceal "⊢"))
((rd_ttile) @operator (#set! conceal "⊨"))
((ls_ttile) @operator (#set! conceal "⊣"))
((ld_ttile) @operator (#set! conceal "⫤"))

; Sets
((subset) @operator (#set! conceal "⊂"))
((supset) @operator (#set! conceal "⊃"))
((subseteq) @operator (#set! conceal "⊆"))
((supseteq) @operator (#set! conceal "⊇"))
((sqsubset) @operator (#set! conceal "⊏"))
((sqsupset) @operator (#set! conceal "⊐"))
((sqsubseteq) @operator (#set! conceal "⊑"))
((sqsupseteq) @operator (#set! conceal "⊒"))
((cap) @operator (#set! conceal "∩"))
((cup) @operator (#set! conceal "∪"))
((sqcap) @operator (#set! conceal "⊓"))
((sqcup) @operator (#set! conceal "⊔"))
((uplus) @operator (#set! conceal "⊎"))
((nat_number_set) @type (#set! conceal "ℕ"))
((int_number_set) @type (#set! conceal "ℤ"))
((real_number_set) @type (#set! conceal "ℝ"))

; Arithmetic and other infix/postfix operators
((times) @operator (#set! conceal "×"))
((div) @operator (#set! conceal "÷"))
((circ) @operator (#set! conceal "∘"))
((cdot) @operator (#set! conceal "⋅"))
((oplus) @operator (#set! conceal "⊕"))
((ominus) @operator (#set! conceal "⊖"))
((odot) @operator (#set! conceal "⊙"))
((oslash) @operator (#set! conceal "⊘"))
((otimes) @operator (#set! conceal "⊗"))
((bigcirc) @operator (#set! conceal "◯"))
((bullet) @operator (#set! conceal "●"))
((star) @operator (#set! conceal "⋆"))
((wr) @operator (#set! conceal "≀"))
((vertvert) @operator (#set! conceal "‖"))
((excl) @operator (#set! conceal "‼"))
((qq) @operator (#set! conceal "⁇"))
((dots_2) @operator (#set! conceal "‥"))
