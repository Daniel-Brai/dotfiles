# Read by gdb (and Neovim's debugger, which runs gdb) before ~/.gdbinit.

# Readable values: structs one field per line, real dynamic type of polymorphic objects
set print pretty on
set print object on
set print static-members off
set print vtbl on
set print demangle on
set print asm-demangle on

# Don't step into the standard library or its headers (use `step` into them with `skip delete`)
skip -gfi /usr/include/c++/*
skip -gfi /usr/include/c++/*/*
skip -gfi /usr/include/c++/*/*/*

set disassembly-flavor intel
set pagination off
set confirm off

set history save on
set history size 10000
set history remove-duplicates 1
set history filename ~/.local/state/gdb_history
